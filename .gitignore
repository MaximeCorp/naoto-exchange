# --- CMake build output -----------------------------------------------
# Anything named "build*" at the repo root — covers the plain `build/`
# used throughout this setup, and any alternate build dirs (build-debug/,
# build-lto/, etc.) without needing to list each one.
/build*/
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
compile_commands.json
install_manifest.txt

# Old per-service Makefile artifacts (matching_engine and friends, before
# the CMake migration) — harmless to keep this even after they're fully
# migrated, since it'll just never match anything.
*.o
MarketExecution
OrderGateway
ClientDetailsProvider

# --- bootstrap-built dependencies --------------------------------------
# DPDK and etcd-cpp-apiv3 build output — regenerated by bootstrap/*.sh,
# hash-suffixed per commit+toolchain (see cmake/FindArtifacts.cmake), and
# large. Never commit this; it's rebuilt from the pinned submodule
# commits, not stored.
/artifacts/

# Build directories left inside the submodules themselves, in case a
# script is ever re-run manually from inside third_party/dpdk or
# third_party/etcd-cpp-apiv3 rather than through bootstrap/.
third_party/dpdk/build/
third_party/etcd-cpp-apiv3/build/

# NOTE: third_party/moodycamel/*.hpp, VERSION, and LICENSE.md are
# intentionally NOT ignored — they're vendored (copy-pasted, not a
# submodule) and must be committed. Don't add a third_party/* wildcard
# pattern above this without excluding moodycamel/, or you'll silently
# drop it from the repo.

# --- editor / OS cruft --------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# --- runtime data, not build output -------------------------------------
# etcd's default data directory when run without --data-dir. Contains
# WAL files that grow large fast and have no business in git — this is
# what let a 61MB .wal file get committed once already; don't remove
# this without moving to an explicit, also-ignored --data-dir instead.
default.etcd/
*.etcd/
*.wal

# --- sanitizer / debugging output --------------------------------------
*.asan.log
core
core.*